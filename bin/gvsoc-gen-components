"""Run the component generation (gvrun components) of several targets in parallel.

Called by the engine CMakeLists at configure time with a file listing one command
per line, its arguments separated by tabs. Each command runs in its own process,
exactly as when they were run one after the other. The longest ones start first,
from the durations of the previous generation kept in a file of the build
directory, so that the generation takes about the time of the longest target.
The output of each command is printed in one block when it ends.
"""

import argparse
import json
import os
import signal
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor


def read_commands(path):
    commands = []
    with open(path, encoding='utf-8') as file:
        for line in file:
            line = line.rstrip('\n')
            if line != '':
                commands.append(line.split('\t'))
    return commands


def command_key(command):
    return ' '.join(command)


def load_times(path):
    try:
        with open(path, encoding='utf-8') as file:
            return json.load(file)
    except (OSError, ValueError):
        return {}


def save_times(path, times):
    tmp_path = f'{path}.tmp.{os.getpid()}'
    with open(tmp_path, 'w', encoding='utf-8') as file:
        json.dump(times, file, indent=2, sort_keys=True)
    os.replace(tmp_path, path)


def main():
    parser = argparse.ArgumentParser(description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('commands', help='file with one command per line, arguments separated by tabs')
    parser.add_argument('-j', '--jobs', type=int, default=os.cpu_count(),
        help='number of commands run at the same time (default: number of cores)')
    parser.add_argument('--times', default=None,
        help='file keeping the duration of each command, to start the longest first')
    args = parser.parse_args()

    commands = read_commands(args.commands)
    times = load_times(args.times) if args.times is not None else {}

    # Longest first; the commands never run come first, in their order, since
    # their duration is unknown
    order = sorted(range(len(commands)),
        key=lambda index: (command_key(commands[index]) in times,
            -times.get(command_key(commands[index]), 0), index))

    lock = threading.Lock()
    processes = set()
    failures = []
    new_times = dict(times)
    start = time.time()

    def run(index):
        command = commands[index]
        command_start = time.time()
        try:
            process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                start_new_session=True)
        except OSError as error:
            with lock:
                sys.stdout.write(f'-- {" ".join(command)}\n{error}\n')
                sys.stdout.flush()
                failures.append((command, None))
            return
        with lock:
            processes.add(process)
        output, _ = process.communicate()
        duration = time.time() - command_start
        with lock:
            processes.discard(process)
            sys.stdout.write(f'-- [{duration:.1f}s] {" ".join(command)}\n')
            sys.stdout.write(output.decode('utf-8', errors='replace'))
            sys.stdout.flush()
            if process.returncode != 0:
                failures.append((command, process.returncode))
            else:
                new_times[command_key(command)] = round(duration, 2)

    def stop(signum, frame):
        with lock:
            for process in processes:
                try:
                    os.killpg(process.pid, signal.SIGTERM)
                except OSError:
                    pass
        sys.exit(1)

    signal.signal(signal.SIGINT, stop)
    signal.signal(signal.SIGTERM, stop)

    with ThreadPoolExecutor(max_workers=max(1, args.jobs)) as executor:
        for _ in executor.map(run, order):
            pass

    if args.times is not None:
        save_times(args.times, new_times)

    print(f'-- Generated the components of {len(commands)} targets in '
        f'{time.time() - start:.1f}s ({args.jobs} jobs)', flush=True)

    if len(failures) != 0:
        for command, returncode in failures:
            status = 'could not start' if returncode is None else f'exit code {returncode}'
            print(f'-- FAILED ({status}): {" ".join(command)}', file=sys.stderr)
        return 1

    return 0


if __name__ == '__main__':
    sys.exit(main())
